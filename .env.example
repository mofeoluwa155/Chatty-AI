# Chatty Core uses its own Supabase PostgreSQL knowledge store.
# These two values are safe for server-side read-only search.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Required only for trusted bulk imports and administrative scripts.
# Never use this value in browser code or any NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional bulk-import tuning.
SUPABASE_IMPORT_BATCH_SIZE=500
SUPABASE_IMPORT_DATASET_VERSION=0.1.0
