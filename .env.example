# ==========================================
# CHATTY AI SERVER
# ==========================================

PORT=3000
NODE_ENV=development

# ==========================================
# GROQ — MAIN AI
# ==========================================

GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=800

# ==========================================
# FIREBASE
# ==========================================

FIREBASE_PROJECT_ID=chatty-ai-80838

FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_KEY=

# ==========================================
# WEB SEARCH
# ==========================================

SEARCH_PROVIDER=brave
SEARCH_API_KEY=YOUR_SEARCH_API_KEY_HERE
SEARCH_MAX_RESULTS=5

# ==========================================
# IMAGE SEARCH
# ==========================================

IMAGE_SEARCH_PROVIDER=brave
IMAGE_SEARCH_API_KEY=YOUR_IMAGE_SEARCH_API_KEY_HERE
IMAGE_SEARCH_MAX_RESULTS=6

# ==========================================
# IMAGE GENERATION
# ==========================================

IMAGE_GEN_PROVIDER=pollinations
IMAGE_GEN_MODEL=black-forest-labs/flux.1-schnell
POLLINATIONS_API_KEY=YOUR_POLLINATIONS_API_KEY_HERE

IMAGE_GEN_TIMEOUT_MS=60000
IMAGE_GEN_MAX_RETRIES=1
IMAGE_GEN_MAX_PROMPT_LENGTH=4000
IMAGE_GEN_RATE_LIMIT=5

# ==========================================
# SUPPORT / EMAIL
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_EMAIL_HERE
SMTP_PASS=YOUR_SMTP_PASSWORD_OR_APP_PASSWORD_HERE
SMTP_FROM=YOUR_SMTP_FROM_ADDRESS_HERE

EMAIL_USER=
EMAIL_PASS=
