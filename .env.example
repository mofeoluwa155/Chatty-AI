# Chatty Core external distributed knowledge search.
# Add these to Vercel Project Settings > Environment Variables for Preview/Production.
# Never commit real credentials or expose them in NEXT_PUBLIC_* variables.
CHATTY_SEARCH_URL=https://your-search-cluster.example
CHATTY_SEARCH_API_KEY=replace-with-a-restricted-indexing-and-search-key
CHATTY_SEARCH_INDEX=chatty-knowledge-v1

# Provisioning defaults; choose shard count after sizing and load testing.
CHATTY_SEARCH_PRIMARY_SHARDS=32
CHATTY_SEARCH_REPLICAS=1

# Optional bulk-import tuning.
CHATTY_IMPORT_BATCH_SIZE=500
