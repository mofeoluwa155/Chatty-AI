{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chatty Core knowledge record",
  "description": "One sourced, reviewable information record for Chatty Core's Supabase knowledge store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "domain", "keywords", "explanation", "source"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable unique ID. Re-importing the same ID updates the existing record."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "domain": { "type": "string", "minLength": 1, "maxLength": 120 },
    "aliases": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "tags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "example": { "type": "string", "maxLength": 5000 },
    "source": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2000
    },
    "licence": { "type": "string", "maxLength": 500 },
    "attribution": { "type": "string", "maxLength": 2000 },
    "language": { "type": "string", "minLength": 2, "maxLength": 16 }
  }
}
